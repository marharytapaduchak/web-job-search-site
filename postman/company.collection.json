  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Create Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corp\",\n  \"logo_url\": \"https://example.com/logo.png\",\n  \"location\": \"San Francisco, CA\",\n  \"description\": \"A leading tech company.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/company/create",
              "host": ["{{base_url}}"],
              "path": ["api", "company", "create"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Body has required fields\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"id\");",
                  "    pm.expect(body).to.have.property(\"name\");",
                  "    pm.expect(body).to.have.property(\"logo_url\");",
                  "    pm.expect(body).to.have.property(\"location\");",
                  "    pm.expect(body).to.have.property(\"description\");",
                  "    pm.collectionVariables.set(\"company_id\", body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/company",
              "host": ["{{base_url}}"],
              "path": ["api", "company"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Body is array containing created company\", function () {",
                  "    const body = pm.response.json();",
                  "    const companyId = pm.collectionVariables.get(\"company_id\");",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "    const found = body.some(function (c) {",
                  "        return String(c.id) === String(companyId);",
                  "    });",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Company by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/company/{{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "company", "{{company_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Body matches created company\", function () {",
                  "    const body = pm.response.json();",
                  "    const companyId = pm.collectionVariables.get(\"company_id\");",
                  "    pm.expect(String(body.id)).to.equal(String(companyId));",
                  "    pm.expect(body).to.have.property(\"name\");",
                  "    pm.expect(body).to.have.property(\"logo_url\");",
                  "    pm.expect(body).to.have.property(\"location\");",
                  "    pm.expect(body).to.have.property(\"description\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Company",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corp Updated\",\n  \"logo_url\": \"https://example.com/logo-v2.png\",\n  \"location\": \"New York, NY\",\n  \"description\": \"An updated description.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/company/{{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "company", "{{company_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Body matches updated values\", function () {",
                  "    const body = pm.response.json();",
                  "    const req = JSON.parse(pm.request.body.raw);",
                  "    pm.expect(body.name).to.equal(req.name);",
                  "    pm.expect(body.logo_url).to.equal(req.logo_url);",
                  "    pm.expect(body.location).to.equal(req.location);",
                  "    pm.expect(body.description).to.equal(req.description);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Company",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/company/{{company_id}}",
